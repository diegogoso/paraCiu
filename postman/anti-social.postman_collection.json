{
  "info": {
    "_postman_id": "8c2f7e92-bf0e-4b7c-a6d9-anti-social-mvp",
    "name": "UnaHur Anti-Social Net API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "postId",
      "value": "1"
    },
    {
      "key": "commentId",
      "value": "1"
    },
    {
      "key": "tagId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/health"
      }
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickName\": \"persistire_user\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Una publicación de prueba\",\n  \"userId\": {{userId}},\n  \"images\": [],\n  \"tagIds\": []\n}"
            },
            "url": "{{baseUrl}}/posts"
          }
        },
        {
          "name": "Get post with relations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "List post comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Create comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Comentario de prueba\",\n  \"userId\": {{userId}}\n}"
            },
            "url": "{{baseUrl}}/posts/{{postId}}/comments"
          }
        },
        {
          "name": "Get comment",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/comments/{{commentId}}"
          }
        }
      ]
    },
    {
      "name": "Tags",
      "item": [
        {
          "name": "List tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tags"
          }
        },
        {
          "name": "Create tag",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Persistencia\"\n}"
            },
            "url": "{{baseUrl}}/tags"
          }
        }
      ]
    }
  ]
}
